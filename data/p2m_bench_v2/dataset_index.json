{
  "dataset": "P2M-Bench",
  "version": "v2.1",
  "format": "single_json_index",
  "description": "Paper-section animation tasks for fixed-probe EMB snapshot evaluation in the ManimAgent EMNLP experiment.",
  "single_json_path": "p2m_bench_v2.json",
  "human_scores_path": "annotations/human_scores.jsonl",
  "human_scores_included": false,
  "splits": {
    "memory_build": 39,
    "fixed_probe": 33,
    "cross_test": 40,
    "test_holdout": 0
  },
  "quarantine": {
    "test_holdout_debug": 195,
    "reasons": {
      "hydration_fallback": 177,
      "promoted_to_headline": 18
    },
    "policy": "Excluded from EMB construction, fixed-probe evaluation, human scoring, and paper headline claims."
  },
  "release_contains": [
    "dataset metadata",
    "headline tasks",
    "quarantined holdout tasks",
    "paper metadata"
  ],
  "release_excludes": [
    "raw full-paper text",
    "draft annotations",
    "example experiment manifests",
    "output-level human scores"
  ]
}
