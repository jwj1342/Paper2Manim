{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed-probe run manifest row",
  "type": "object",
  "required": [
    "task_id",
    "condition",
    "seed",
    "attempt_0_video_path",
    "trace_path",
    "reflection_depth",
    "vlm_scores",
    "final_status",
    "writes_to_emb"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "condition": {
      "enum": [
        "VLM Reflection Only",
        "EMB@0",
        "EMB@50",
        "EMB@100",
        "EMB@200",
        "EMB@400"
      ]
    },
    "seed": {"type": "integer"},
    "attempt_0_video_path": {"type": "string"},
    "trace_path": {"type": "string"},
    "reflection_depth": {"type": "number", "minimum": 0},
    "vlm_scores": {"type": "object"},
    "final_status": {"type": "string"},
    "writes_to_emb": {"const": false},
    "snapshot_id": {"type": "string"},
    "blind_output_id": {"type": "string"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
