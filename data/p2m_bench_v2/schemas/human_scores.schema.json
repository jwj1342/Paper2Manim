{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human score row",
  "type": "object",
  "required": [
    "blind_output_id",
    "task_id",
    "rater_id_hash",
    "scores",
    "human_pass_at_1",
    "fatal_flags",
    "comment",
    "created_at"
  ],
  "properties": {
    "blind_output_id": {"type": "string"},
    "task_id": {"type": "string"},
    "paper_id": {"type": "string"},
    "rater_id_hash": {"type": "string"},
    "condition": {"type": "string"},
    "condition_hidden": {"type": "object"},
    "scores": {
      "type": "object",
      "required": [
        "paper_alignment",
        "key_claim_coverage",
        "visual_robustness",
        "animation_flow",
        "first_attempt_usability"
      ],
      "properties": {
        "paper_alignment": {"type": "integer", "minimum": 1, "maximum": 5},
        "key_claim_coverage": {"type": "integer", "minimum": 1, "maximum": 5},
        "visual_robustness": {"type": "integer", "minimum": 1, "maximum": 5},
        "animation_flow": {"type": "integer", "minimum": 1, "maximum": 5},
        "first_attempt_usability": {"type": "integer", "minimum": 1, "maximum": 5}
      },
      "additionalProperties": false
    },
    "human_pass_at_1": {"type": "boolean"},
    "fatal_flags": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "vlm_scores": {"type": "object"},
    "vlm_pass_at_1": {"type": "boolean"},
    "comment": {"type": "string"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
