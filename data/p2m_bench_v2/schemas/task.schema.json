{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P2M-Bench v2.1 task",
  "type": "object",
  "required": [
    "task_id",
    "paper_id",
    "split",
    "domain",
    "scene_role",
    "category",
    "difficulty",
    "model_input",
    "eval_only",
    "target_annotation_status",
    "output_annotation_status",
    "contamination"
  ],
  "properties": {
    "arxiv_id": {"type": "string"},
    "category": {"type": "string"},
    "contamination": {
      "type": "object",
      "required": ["cutoff_reference", "paper_publish_date", "publication_stratum", "used_for_cutoff_stratification"],
      "properties": {
        "cutoff_reference": {"type": "string", "format": "date"},
        "paper_publish_date": {"type": "string", "format": "date"},
        "publication_stratum": {"enum": ["pre_cutoff", "post_cutoff"]},
        "used_for_cutoff_stratification": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "cross_idx": {"type": ["integer", "null"]},
    "difficulty": {"type": "string"},
    "domain": {"type": "string"},
    "eval_only": {
      "type": "object",
      "required": ["annotation_source", "hydration_status"],
      "properties": {
        "annotation_source": {"type": "string"},
        "draft_annotation_sidecar": {"type": "string"},
        "human_rubric": {"type": "object", "additionalProperties": {"type": "string"}},
        "hydration_error": {"type": "string"},
        "hydration_status": {"type": "string"}
      },
      "additionalProperties": false
    },
    "exclude_from_main": {"type": "boolean"},
    "exclude_reason": {"type": ["string", "null"]},
    "expected_min_memory_records": {"type": "integer", "minimum": 0},
    "expected_scene_count_min": {"type": ["integer", "null"], "minimum": 0},
    "human_eval_candidate": {"type": "boolean"},
    "human_eval_candidate_pending_audit": {"type": "boolean"},
    "human_eval_strata": {"type": ["object", "null"]},
    "id": {"type": "string"},
    "model_input": {
      "type": "object",
      "required": ["paper_title", "target_unit", "required_prior_context", "prior_objects", "scene_role", "domain", "source_type"],
      "properties": {
        "abstract": {"type": "string"},
        "domain": {"type": "string"},
        "paper_title": {"type": "string"},
        "prior_objects": {"type": "array", "items": {"type": "object"}},
        "required_prior_context": {"type": "string"},
        "scene_role": {"type": "string"},
        "source_type": {"type": "string"},
        "target_unit": {
          "type": "object",
          "required": ["anchor", "text", "title", "type", "required_prior_context", "prior_objects"],
          "properties": {
            "anchor": {"type": "object"},
            "prior_objects": {"type": "array", "items": {"type": "object"}},
            "required_prior_context": {"type": "string"},
            "text": {"type": "string"},
            "title": {"type": "string"},
            "type": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "original_split": {"type": "string"},
    "output_annotation_status": {"type": "string"},
    "paper_id": {"type": "string"},
    "paper_license": {"type": "string"},
    "paper_license_source": {"type": "string"},
    "paper_license_url": {"type": "string"},
    "paper_publish_date": {"type": "string", "format": "date"},
    "paper_title": {"type": "string"},
    "probe_idx": {"type": ["integer", "null"]},
    "scene_role": {"type": "string"},
    "section": {"type": "string"},
    "source_paper_text": {
      "type": "object",
      "required": ["paper_file", "raw_paper_text_available_in_release", "raw_paper_text_internal_source", "use_in_main_runner"],
      "properties": {
        "paper_file": {"type": "string"},
        "raw_paper_text_available_in_release": {"type": "boolean"},
        "raw_paper_text_internal_source": {"type": "string"},
        "use_in_main_runner": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "source_type": {"type": "string"},
    "split": {"enum": ["memory_build", "fixed_probe", "cross_test", "test_holdout_debug"]},
    "stream_idx": {"type": ["integer", "null"]},
    "target_annotation_status": {"type": "string"},
    "target_audit_required_before_human_scoring": {"type": "boolean"},
    "task_id": {"type": "string"},
    "track": {"type": "string"},
    "used_in_appendix_cross_domain": {"type": "boolean"},
    "used_in_main_experiment": {"type": "boolean"},
    "used_in_online_curve": {"type": "boolean"}
  },
  "additionalProperties": false
}
