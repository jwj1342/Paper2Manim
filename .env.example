# =============================================================================
# Paper2Manim — environment template
#
# Setup:
#   1) cp .env.example .env
#   2) Choose your LLM provider below and fill the matching *_API_KEY.
#   3) The .env file is gitignored — never commit it.
#
# All variables are read by paper2manim/config/env.py via pydantic-settings.
# Lines starting with # are comments. Quotes are optional.
# =============================================================================

# ---- Primary LLM provider ----
# Choose one: mimo | deepseek | doubao | openai
# Leave empty to auto-detect from whichever *_API_KEY is filled in below.
# All four providers expose an OpenAI-compatible /chat/completions endpoint, so
# the same agent code targets any of them by varying base_url + model.
LLM_PROVIDER=doubao

# Generic API key (preferred). If empty, falls back to the provider-specific
# key matching LLM_PROVIDER (see the section below).
# LLM_API_KEY=

# Optional overrides — leave empty to use the provider's defaults. These are
# useful when the provider releases a new model id you want to pin against.
# LLM_BASE_URL=
# LLM_MODEL_FLASH=
# LLM_MODEL_PRO=


# ---- Provider-specific keys (fill the one matching LLM_PROVIDER) ----
# MiMo (Xiaomi Token Plan), tp- prefix. https://www.xiaomimimo.com/
MIMO_API_KEY=

# DeepSeek, sk- prefix. https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Volcengine Ark (豆包). For LLM_PROVIDER=doubao you can either fill this or
# reuse the VLM_API_KEY below (which is the same Volcengine endpoint).
DOUBAO_API_KEY=

# OpenAI. https://platform.openai.com/
OPENAI_API_KEY=


# ---- VLM (MVP 3.0 scene critic) ----
# Used by paper2manim/infrastructure/vlm/ and by LLM_PROVIDER=doubao as a key/
# model fallback when DOUBAO_API_KEY/LLM_MODEL_FLASH are unset. Defaults below
# point at the Volcengine Ark endpoint.
VLM_API_KEY=
VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VLM_MODEL=
VLM_ENABLE=false


# ---- Project defaults (OPTIONAL — sane defaults are baked in) ----

# Where run artifacts (storyboards, generated code, attempts, mp4s) are written.
# Default: ./runs (relative to the project root). Override to e.g. an HPC scratch dir.
# PAPER2MANIM_RUNS_DIR=./runs

# Default LLM role alias used by agents. Maps to a real model via the provider
# table in paper2manim/llm.py.
#   flash  -> lightweight (storyboarder/coder/reviewer)
#   pro    -> long-context (summarizer on long PDFs)
PAPER2MANIM_DEFAULT_MODEL=flash

# Max self-correction iterations for one scene in MVP 2.0's reflection loop.
PAPER2MANIM_MAX_RETRIES=3

# Manim render quality: l = 480p15 (fast iteration), m = 720p30, h = 1080p60.
PAPER2MANIM_QUALITY=l


# ---- Observability (OPTIONAL) ----
# LangSmith tracing — set both to enable per-node trace dashboards.
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=paper2manim
