# =============================================================================
# Paper2Manim — environment template
#
# Setup:
#   1) cp .env.example .env
#   2) Fill in MIMO_API_KEY below.
#   3) The .env file is gitignored — never commit it.
#
# All variables are read by paper2manim/config.py via pydantic-settings.
# Lines starting with # are comments. Quotes are optional.
# =============================================================================

# ---- LLM provider (REQUIRED) ----
# Xiaomi MiMo Token Plan — OpenAI-compatible API.
# Get a key at the MiMo console; it should start with "tp-".
MIMO_API_KEY=tp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL. The Token Plan endpoint is what `tp-` keys authenticate against.
# (The bare api.xiaomimimo.com host serves a different keyspace and will 401.)
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1


# ---- Project defaults (OPTIONAL — sane defaults are baked in) ----

# Where run artifacts (storyboards, generated code, attempts, mp4s) are written.
# Default: ./runs (relative to the project root). Override to e.g. an HPC scratch dir.
# PAPER2MANIM_RUNS_DIR=./runs

# Default LLM tier alias. Maps to a real model in paper2manim/llm.py.
#   flash  -> mimo-v2.5       (default; storyboarder/coder/reviewer)
#   pro    -> mimo-v2.5-pro   (long-context summarization)
#   v2     -> mimo-v2-pro     (fallback)
PAPER2MANIM_DEFAULT_MODEL=flash

# Max self-correction iterations for one scene in MVP 2.0's reflection loop.
PAPER2MANIM_MAX_RETRIES=3

# Manim render quality: l = 480p15 (fast iteration), m = 720p30, h = 1080p60.
PAPER2MANIM_QUALITY=l


# ---- Observability (OPTIONAL) ----
# LangSmith tracing — set both to enable per-node trace dashboards.
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=paper2manim
